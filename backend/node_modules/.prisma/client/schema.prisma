generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrganizationStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum RoleName {
  SUPER_ADMIN
  ADMIN
  TRANSPORT_MANAGER
  DISPATCHER
  FLEET_MANAGER
  ACCOUNTS
  DRIVER
  VIEWER
}

enum FuelType {
  DIESEL
  PETROL
  CNG
  ELECTRIC
}

enum VehicleTypeStatus {
  ACTIVE
  INACTIVE
}

enum VehicleStatus {
  AVAILABLE
  ASSIGNED
  IN_TRANSIT
  MAINTENANCE
  INACTIVE
}

enum OwnershipType {
  OWNED
  LEASED
  MARKET_ATTACHED
}

enum DriverStatus {
  AVAILABLE
  ASSIGNED
  ON_TRIP
  OFF_DUTY
  INACTIVE
}

enum CustomerType {
  SHIPPER
  CONSIGNEE
  BOTH
}

enum CustomerStatus {
  ACTIVE
  INACTIVE
}

enum CarrierStatus {
  ACTIVE
  INACTIVE
  BLACKLISTED
}

enum ShipmentStatus {
  DRAFT
  CREATED
  VALIDATED
  PLANNED
  ASSIGNED
  IN_TRANSIT
  DELIVERED
  CANCELLED
}

enum FreightTerm {
  PAID
  TO_PAY
  TO_BE_BILLED
}

enum LRStatus {
  ISSUED
  CANCELLED
}

enum RouteStatus {
  ACTIVE
  INACTIVE
}

enum TripStatus {
  PLANNED
  ASSIGNED
  DISPATCHED
  IN_TRANSIT
  PAUSED
  COMPLETED
  CANCELLED
}

enum StopType {
  PICKUP
  DELIVERY
  WAYPOINT
}

enum StopStatus {
  PENDING
  ARRIVED
  DEPARTED
  SKIPPED
}

enum DispatchStatus {
  DRAFT
  APPROVED
  DISPATCHED
  GATE_OUT
  CANCELLED
}

model Organization {
  id        String             @id @default(uuid()) @db.Uuid
  name      String             @db.VarChar(255)
  code      String             @unique @db.VarChar(50)
  status    OrganizationStatus @default(ACTIVE)
  createdAt DateTime           @default(now()) @map("created_at")
  updatedAt DateTime           @updatedAt @map("updated_at")
  deletedAt DateTime?          @map("deleted_at")

  users         User[]
  vehicleTypes  VehicleType[]
  vehicles      Vehicle[]
  drivers       Driver[]
  customers     Customer[]
  carriers      Carrier[]
  shipments     Shipment[]
  lorryReceipts LorryReceipt[]
  routes        Route[]
  trips         Trip[]
  dispatches    Dispatch[]

  @@map("organizations")
}

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  name        RoleName @unique
  description String?  @db.VarChar(255)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  users User[]

  @@map("roles")
}

model User {
  id             String     @id @default(uuid()) @db.Uuid
  organizationId String     @map("organization_id") @db.Uuid
  roleId         String     @map("role_id") @db.Uuid
  email          String     @unique @db.VarChar(255)
  password       String     @db.VarChar(255)
  firstName      String     @map("first_name") @db.VarChar(100)
  lastName       String     @map("last_name") @db.VarChar(100)
  phone          String?    @db.VarChar(20)
  status         UserStatus @default(ACTIVE)
  refreshToken   String?    @map("refresh_token") @db.Text
  lastLoginAt    DateTime?  @map("last_login_at")
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")
  deletedAt      DateTime?  @map("deleted_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  role         Role         @relation(fields: [roleId], references: [id], onDelete: Restrict)
  drivers      Driver[]

  @@index([organizationId])
  @@index([roleId])
  @@index([email])
  @@map("users")
}

model VehicleType {
  id             String            @id @default(uuid()) @db.Uuid
  organizationId String            @map("organization_id") @db.Uuid
  name           String            @db.VarChar(100)
  code           String            @db.VarChar(50)
  capacityTons   Float             @map("capacity_tons")
  volumeCuFt     Float?            @map("volume_cu_ft")
  axleCount      Int?              @map("axle_count")
  fuelType       FuelType          @default(DIESEL) @map("fuel_type")
  status         VehicleTypeStatus @default(ACTIVE)
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")
  deletedAt      DateTime?         @map("deleted_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  vehicles     Vehicle[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@index([organizationId, status])
  @@map("vehicle_types")
}

model Vehicle {
  id                 String        @id @default(uuid()) @db.Uuid
  organizationId     String        @map("organization_id") @db.Uuid
  vehicleTypeId      String        @map("vehicle_type_id") @db.Uuid
  registrationNumber String        @map("registration_number") @db.VarChar(50)
  chassisNumber      String?       @map("chassis_number") @db.VarChar(100)
  engineNumber       String?       @map("engine_number") @db.VarChar(100)
  make               String?       @db.VarChar(100)
  model              String?       @db.VarChar(100)
  year               Int?
  status             VehicleStatus @default(AVAILABLE)
  ownershipType      OwnershipType @default(OWNED) @map("ownership_type")
  currentOdometer    Float         @default(0) @map("current_odometer")
  createdAt          DateTime      @default(now()) @map("created_at")
  updatedAt          DateTime      @updatedAt @map("updated_at")
  deletedAt          DateTime?     @map("deleted_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  vehicleType  VehicleType  @relation(fields: [vehicleTypeId], references: [id], onDelete: Restrict)
  trips        Trip[]

  @@unique([organizationId, registrationNumber])
  @@index([organizationId])
  @@index([organizationId, status])
  @@index([vehicleTypeId])
  @@map("vehicles")
}

model Driver {
  id              String       @id @default(uuid()) @db.Uuid
  organizationId  String       @map("organization_id") @db.Uuid
  userId          String?      @map("user_id") @db.Uuid
  firstName       String       @map("first_name") @db.VarChar(100)
  lastName        String       @map("last_name") @db.VarChar(100)
  phone           String       @db.VarChar(20)
  licenseNumber   String       @map("license_number") @db.VarChar(50)
  licenseCategory String?      @map("license_category") @db.VarChar(50)
  licenseExpiry   DateTime?    @map("license_expiry")
  status          DriverStatus @default(AVAILABLE)
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")
  deletedAt       DateTime?    @map("deleted_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  trips        Trip[]

  @@unique([organizationId, licenseNumber])
  @@index([organizationId])
  @@index([organizationId, status])
  @@index([userId])
  @@map("drivers")
}

model Customer {
  id             String         @id @default(uuid()) @db.Uuid
  organizationId String         @map("organization_id") @db.Uuid
  name           String         @db.VarChar(255)
  code           String         @db.VarChar(50)
  type           CustomerType   @default(BOTH)
  gstin          String?        @db.VarChar(20)
  pan            String?        @db.VarChar(20)
  email          String?        @db.VarChar(255)
  phone          String?        @db.VarChar(20)
  addressLine1   String?        @map("address_line1") @db.VarChar(255)
  addressLine2   String?        @map("address_line2") @db.VarChar(255)
  city           String?        @db.VarChar(100)
  state          String?        @db.VarChar(100)
  pincode        String?        @db.VarChar(20)
  status         CustomerStatus @default(ACTIVE)
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")
  deletedAt      DateTime?      @map("deleted_at")

  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  customerShipments  Shipment[]   @relation("CustomerShipments")
  consigneeShipments Shipment[]   @relation("ConsigneeShipments")

  @@unique([organizationId, code])
  @@index([organizationId])
  @@index([organizationId, status])
  @@map("customers")
}

model Carrier {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @map("organization_id") @db.Uuid
  name           String        @db.VarChar(255)
  code           String        @db.VarChar(50)
  gstin          String?       @db.VarChar(20)
  pan            String?       @db.VarChar(20)
  email          String?       @db.VarChar(255)
  phone          String?       @db.VarChar(20)
  addressLine1   String?       @map("address_line1") @db.VarChar(255)
  city           String?       @db.VarChar(100)
  state          String?       @db.VarChar(100)
  pincode        String?       @db.VarChar(20)
  rating         Float?        @default(5.0)
  status         CarrierStatus @default(ACTIVE)
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")
  deletedAt      DateTime?     @map("deleted_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  trips        Trip[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@index([organizationId, status])
  @@map("carriers")
}

model Shipment {
  id                   String         @id @default(uuid()) @db.Uuid
  organizationId       String         @map("organization_id") @db.Uuid
  bookingNumber        String         @map("booking_number") @db.VarChar(50)
  customerId           String         @map("customer_id") @db.Uuid
  consigneeId          String?        @map("consignee_id") @db.Uuid
  originCity           String         @map("origin_city") @db.VarChar(100)
  originPincode        String?        @map("origin_pincode") @db.VarChar(20)
  destinationCity      String         @map("destination_city") @db.VarChar(100)
  destinationPincode   String?        @map("destination_pincode") @db.VarChar(20)
  pickupDate           DateTime?      @map("pickup_date")
  expectedDeliveryDate DateTime?      @map("expected_delivery_date")
  status               ShipmentStatus @default(CREATED)
  totalWeightKg        Float          @default(0) @map("total_weight_kg")
  totalVolumeCuFt      Float          @default(0) @map("total_volume_cu_ft")
  freightAmount        Float          @default(0) @map("freight_amount")
  createdAt            DateTime       @default(now()) @map("created_at")
  updatedAt            DateTime       @updatedAt @map("updated_at")
  deletedAt            DateTime?      @map("deleted_at")

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  customer      Customer       @relation("CustomerShipments", fields: [customerId], references: [id], onDelete: Restrict)
  consignee     Customer?      @relation("ConsigneeShipments", fields: [consigneeId], references: [id], onDelete: SetNull)
  items         ShipmentItem[]
  lorryReceipts LorryReceipt[]
  tripStops     TripStop[]

  @@unique([organizationId, bookingNumber])
  @@index([organizationId])
  @@index([organizationId, status])
  @@index([customerId])
  @@map("shipments")
}

model ShipmentItem {
  id            String   @id @default(uuid()) @db.Uuid
  shipmentId    String   @map("shipment_id") @db.Uuid
  description   String   @db.VarChar(255)
  quantity      Int      @default(1)
  weightKg      Float    @default(0) @map("weight_kg")
  volumeCuFt    Float    @default(0) @map("volume_cu_ft")
  declaredValue Float?   @map("declared_value")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  shipment Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@index([shipmentId])
  @@map("shipment_items")
}

model LorryReceipt {
  id               String      @id @default(uuid()) @db.Uuid
  organizationId   String      @map("organization_id") @db.Uuid
  shipmentId       String      @map("shipment_id") @db.Uuid
  lrNumber         String      @map("lr_number") @db.VarChar(50)
  lrDate           DateTime    @default(now()) @map("lr_date")
  consignorName    String      @map("consignor_name") @db.VarChar(255)
  consignorAddress String?     @map("consignor_address") @db.VarChar(255)
  consigneeName    String      @map("consignee_name") @db.VarChar(255)
  consigneeAddress String?     @map("consignee_address") @db.VarChar(255)
  freightTerms     FreightTerm @default(TO_PAY) @map("freight_terms")
  basicFreight     Float       @default(0) @map("basic_freight")
  otherCharges     Float       @default(0) @map("other_charges")
  taxAmount        Float       @default(0) @map("tax_amount")
  totalAmount      Float       @default(0) @map("total_amount")
  remarks          String?     @db.VarChar(255)
  status           LRStatus    @default(ISSUED)
  createdAt        DateTime    @default(now()) @map("created_at")
  updatedAt        DateTime    @updatedAt @map("updated_at")
  deletedAt        DateTime?   @map("deleted_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  shipment     Shipment     @relation(fields: [shipmentId], references: [id], onDelete: Restrict)

  @@unique([organizationId, lrNumber])
  @@index([organizationId])
  @@index([shipmentId])
  @@map("lorry_receipts")
}

model Route {
  id               String      @id @default(uuid()) @db.Uuid
  organizationId   String      @map("organization_id") @db.Uuid
  name             String      @db.VarChar(255)
  code             String      @db.VarChar(50)
  originCity       String      @map("origin_city") @db.VarChar(100)
  originState      String?     @map("origin_state") @db.VarChar(100)
  destinationCity  String      @map("destination_city") @db.VarChar(100)
  destinationState String?     @map("destination_state") @db.VarChar(100)
  distanceKm       Float       @default(0) @map("distance_km")
  estimatedHours   Float       @default(0) @map("estimated_hours")
  status           RouteStatus @default(ACTIVE)
  createdAt        DateTime    @default(now()) @map("created_at")
  updatedAt        DateTime    @updatedAt @map("updated_at")
  deletedAt        DateTime?   @map("deleted_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  trips        Trip[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@index([organizationId, status])
  @@map("routes")
}

model Trip {
  id               String     @id @default(uuid()) @db.Uuid
  organizationId   String     @map("organization_id") @db.Uuid
  tripNumber       String     @map("trip_number") @db.VarChar(50)
  routeId          String?    @map("route_id") @db.Uuid
  vehicleId        String?    @map("vehicle_id") @db.Uuid
  driverId         String?    @map("driver_id") @db.Uuid
  carrierId        String?    @map("carrier_id") @db.Uuid
  status           TripStatus @default(PLANNED)
  plannedStartDate DateTime?  @map("planned_start_date")
  plannedEndDate   DateTime?  @map("planned_end_date")
  actualStartDate  DateTime?  @map("actual_start_date")
  actualEndDate    DateTime?  @map("actual_end_date")
  startOdometer    Float?     @map("start_odometer")
  endOdometer      Float?     @map("end_odometer")
  remarks          String?    @db.VarChar(255)
  createdAt        DateTime   @default(now()) @map("created_at")
  updatedAt        DateTime   @updatedAt @map("updated_at")
  deletedAt        DateTime?  @map("deleted_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  route        Route?       @relation(fields: [routeId], references: [id], onDelete: SetNull)
  vehicle      Vehicle?     @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  driver       Driver?      @relation(fields: [driverId], references: [id], onDelete: SetNull)
  carrier      Carrier?     @relation(fields: [carrierId], references: [id], onDelete: SetNull)
  stops        TripStop[]
  dispatches   Dispatch[]

  @@unique([organizationId, tripNumber])
  @@index([organizationId])
  @@index([organizationId, status])
  @@index([vehicleId])
  @@index([driverId])
  @@map("trips")
}

model TripStop {
  id            String     @id @default(uuid()) @db.Uuid
  sequence      Int        @default(1)
  tripId        String     @map("trip_id") @db.Uuid
  shipmentId    String?    @map("shipment_id") @db.Uuid
  stopType      StopType   @default(PICKUP) @map("stop_type")
  locationName  String     @map("location_name") @db.VarChar(255)
  city          String     @db.VarChar(100)
  pincode       String?    @db.VarChar(20)
  status        StopStatus @default(PENDING)
  arrivalTime   DateTime?  @map("arrival_time")
  departureTime DateTime?  @map("departure_time")
  remarks       String?    @db.VarChar(255)
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")

  trip     Trip      @relation(fields: [tripId], references: [id], onDelete: Cascade)
  shipment Shipment? @relation(fields: [shipmentId], references: [id], onDelete: SetNull)

  @@index([tripId])
  @@index([shipmentId])
  @@map("trip_stops")
}

model Dispatch {
  id                 String         @id @default(uuid()) @db.Uuid
  organizationId     String         @map("organization_id") @db.Uuid
  tripId             String         @map("trip_id") @db.Uuid
  dispatchNumber     String         @map("dispatch_number") @db.VarChar(50)
  gatePassNumber     String?        @map("gate_pass_number") @db.VarChar(50)
  status             DispatchStatus @default(DISPATCHED)
  dispatchedAt       DateTime       @default(now()) @map("dispatched_at")
  dispatchedByUserId String?        @map("dispatched_by_user_id") @db.Uuid
  remarks            String?        @db.VarChar(255)
  createdAt          DateTime       @default(now()) @map("created_at")
  updatedAt          DateTime       @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  trip         Trip         @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@unique([organizationId, dispatchNumber])
  @@index([organizationId])
  @@index([tripId])
  @@map("dispatches")
}
